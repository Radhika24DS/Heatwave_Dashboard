# Application Settings
PROJECT_NAME="Real-Time AI Heatwave EWS"
API_V1_STR="/api/v1"
ALLOWED_ORIGINS="http://localhost:5173,https://yourdomain.com"

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=heatwave_db

# The complete async connection URL (will be computed automatically by config if not set)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/heatwave_db

# Google Gemini Configuration
GOOGLE_API_KEY=your_google_api_key_here
